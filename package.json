{
  "name": "swayrouter",
  "version": "1.0.2",
  "description": "Self-hosted AI gateway with a clean local dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envielxyz/SwayRouter.git"
  },
  "homepage": "https://github.com/envielxyz/SwayRouter#readme",
  "bugs": {
    "url": "https://github.com/envielxyz/SwayRouter/issues"
  },
  "keywords": [
    "ai",
    "api-gateway",
    "llm",
    "router",
    "oauth",
    "openai-compatible",
    "bun"
  ],
  "module": "src/server.ts",
  "type": "module",
  "bin": {
    "swayrouter": "cli/cli.js"
  },
  "files": [
    "cli",
    "src",
    "!src/**/*.test.js",
    "!src/**/*.test.ts",
    "dashboard/dist",
    "!cli/**/*.test.js",
    "!cli/LICENSE",
    ".env.example",
    "README.md",
    "README.id.md",
    "CHANGELOG.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build:dashboard": "bun run --cwd dashboard build",
    "test:e2e": "bun run build:dashboard && playwright test",
    "test:e2e:install": "playwright install chromium",
    "prepack": "bun run build:dashboard",
    "package:check": "bun pm pack --dry-run --ignore-scripts",
    "routes:check": "bun scripts/gen-routes.mjs --check",
    "build:binary": "bun scripts/build-binary.mjs",
    "smoke:binary": "bun scripts/smoke-binary.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.14",
    "better-sqlite3": "^13.0.3",
    "typescript": "^5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^5",
    "confbox": "^0.2.4",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "node-machine-id": "^1.1.12",
    "open": "^11",
    "ora": "^9",
    "socks-proxy-agent": "^10.1.0",
    "sql.js": "^1.14.1",
    "undici": "^7.19.2",
    "uuid": "^13"
  },
  "optionalDependencies": {
    "systray2": "^2.1.0"
  }
}
