# Sway Router — minimal production environment
# Performance, queue, body-budget, retry, usage-retention, and payload-capture
# settings are automatic by default. Advanced overrides are documented in
# README.md; do not add them here unless you have measured a real deployment.

NODE_ENV=production
PORT=14045

# Native runtime listens on loopback by default. Docker overrides this inside
# the container while publishing the host port to loopback only.
#HOSTNAME=127.0.0.1
# Optional persistent data directory. Defaults to:
# Linux/macOS: ~/.swayrouter
# Windows:     %APPDATA%\.swayrouter
#DATA_DIR=./data
# Optional secret overrides. A single Sway Router instance generates strong,
# persistent values automatically inside DATA_DIR on first start. Set these
# explicitly only when you manage secrets externally or run multiple instances
# against the same data directory.
#JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
#API_KEY_SECRET=replace-with-a-random-secret-at-least-32-characters-long
#MACHINE_ID_SALT=replace-with-a-random-private-salt

# Optional provider OAuth clients. Leave unset unless you bring your own
# Google OAuth clients for the Gemini CLI or Antigravity integrations.
# Gemini OAuth overrides (optional)
#GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
#GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Antigravity ships with its public application OAuth credentials. Override only when needed.
#ANTIGRAVITY_OAUTH_CLIENT_ID=your-antigravity-oauth-client-id
#ANTIGRAVITY_OAUTH_CLIENT_SECRET=your-antigravity-oauth-client-secret

# Optional public base URL for callbacks and reverse-proxy deployments.
#BASE_URL=https://router.example.internal
#TRUST_PROXY=false
#AUTH_COOKIE_SECURE=false
#ENABLE_REQUEST_LOGS=false
#ENABLE_TRANSLATOR=false
#TAVILY_API_KEY=your-tavily-api-key
#BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# Advanced performance overrides intentionally live in README.md so the
# normal setup stays small. Automatic resource profiles detect memory/CPU and
# bound concurrency, queues, request bodies, retries, and usage retention.
